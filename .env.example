# ==============================================================================
# KONNEXY TAP: VARIÁVEIS DE AMBIENTE
# ==============================================================================

# URL da Aplicação (usada em links absolutos e redirecionamentos)
NEXT_PUBLIC_APP_URL=https://tap.konnexy.com.br

# Credenciais do Supabase (Opcionais no modo demonstração local)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# IMPORTANTE DE SEGURANÇA:
# NUNCA insira a SUPABASE_SERVICE_ROLE_KEY no frontend ou em variáveis prefixadas com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada
