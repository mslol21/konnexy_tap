# ==============================================================================
# OTIMIZA MEU NEGÓCIO — PLACA INTELIGENTE DE AVALIAÇÕES
# ==============================================================================

# URL pública atual da aplicação. Troque quando houver domínio próprio.
NEXT_PUBLIC_APP_URL=https://konnexytap.vercel.app

# WhatsApp comercial, somente números com DDI + DDD.
# Exemplo: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Recursos de Fase 2 ficam desligados no MVP.
NEXT_PUBLIC_ENABLE_SMART_PAGES=false

# Credenciais públicas do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave PRIVADA usada exclusivamente no servidor para operações controladas,
# como resolver a placa e registrar telemetria no fluxo /t/[code].
# NUNCA prefixar com NEXT_PUBLIC_ e nunca expor no navegador/repositório.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada
